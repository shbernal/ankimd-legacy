{
  "name": "@shbernal/ankimd",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "description": "Core Anki-to-Markdown conversion utilities for ankimd",
  "author": "shbernal <shbernal.01@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/shbernal/ankimd",
  "repository": {
    "type": "git",
    "url": "https://github.com/shbernal/ankimd.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');['dist','node_modules','tsconfig.tsbuildinfo'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "build": "tsc -b tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --list-different . | xargs -r prettier --write"
  },
  "engines": {
    "node": ">=20"
  }
}
