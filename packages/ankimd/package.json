{
  "name": "@shbernal/ankimd",
  "version": "0.1.2",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "description": "Convert Anki exports into readable Markdown flashcards.",
  "author": "shbernal <shbernal.01@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/shbernal/ankimd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shbernal/ankimd.git",
    "directory": "packages/ankimd"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "anki",
    "markdown",
    "flashcards",
    "spaced-repetition",
    "anki-export",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');['dist','node_modules','tsconfig.tsbuildinfo'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "build": "tsc -b tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  }
}
