{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "//#test:workspace": {
      "dependsOn": ["@shbernal/ankimd#build", "@shbernal/ankimd-cli#build"],
      "inputs": ["test/**"],
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "clean": {
      "cache": false,
      "outputs": []
    }
  }
}
