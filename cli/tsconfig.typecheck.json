{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "paths": {
      "@shbernal/ankimd": ["../packages/ankimd/src"],
